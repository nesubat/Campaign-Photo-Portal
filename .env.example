# Copy this file to .env and fill in the values from deploying
# apps-script/DriveUploader.gs. .env is gitignored - never commit your real one.
DRIVE_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXX/exec
DRIVE_SHARED_SECRET=choose-a-long-random-string-here

# Required for login (Flask session cookie signing) - choose a long random string.
SECRET_KEY=choose-a-long-random-string-here

# First Admin account, created automatically on startup if it doesn't exist yet.
# Change ADMIN_PIN afterward via the app itself, not here - editing it here won't
# reset an already-created account.
ADMIN_NAME=Admin
ADMIN_PIN=1234

# Pack labels for New Store Kits (Zebra ZD420d on this server machine) - see labels.py.
# LABEL_PRINTER_NAME must match the printer's Windows name exactly; list the installed
# ones with:  py labels.py --list-printers   (then check with: py labels.py --test-print)
# Leave it empty until the printer is set up - Print then opens a label preview instead.
LABEL_PRINTER_NAME=
# Label stock in millimetres, as it FEEDS through the printer: WIDTH is across the
# print head (at most 104 mm on the ZD420d), HEIGHT is the length along the feed.
# Until the real stock is known this is the standard 100 x 150 mm (4 x 6 in) courier label. LABEL_DPI is the printer's resolution:
# 203 for the ZD420d-203dpi model, 300 for the 300 dpi one.
LABEL_WIDTH_MM=100
LABEL_HEIGHT_MM=150
LABEL_DPI=203
LABEL_MARGIN_MM=4
# Which way the label reads: landscape (default - the long side across; on the tall
# 100 x 150 stock the label is turned 90 degrees for the printer), landscape-flipped
# if the labels come out upside down, or portrait (the stock as it feeds).
LABEL_ORIENTATION=landscape
# Label font (a .ttf file on this machine). Default: Arial Black, which every Windows
# install has at C:\Windows\Fonts\ariblk.ttf. Leave it empty to use that.
LABEL_FONT_FILE=
